<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="PrimaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">@color/bg_primary_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="SecondaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_header_button</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="HeaderButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_header_button</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="SegmentOption" parent="android:style/Widget.Material.CompoundButton.RadioButton">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:buttonTint">@color/primary</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="GlassDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
    </style>
</resources>
