<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">

    <com.gotolibrary.app.GlassBackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

    <LinearLayout
        android:id="@+id/contentColumn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="34dp">

        <LinearLayout
            android:id="@+id/headerPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:contentDescription="@string/brand_icon"
                android:src="@drawable/ic_library_brand" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/surface"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/app_subtitle"
                    android:textColor="#C9E4D9"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <Button
                android:id="@+id/loginButton"
                style="@style/HeaderButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/wechat_login" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/statusPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="17dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.gotolibrary.app.PulseDotView
                    android:id="@+id/statusDot"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/status_indicator" />

                <TextView
                    android:id="@+id/taskTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ready"
                    android:textColor="@color/ink"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/taskDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="6dp"
                android:text="@string/ready_detail"
                android:textColor="@color/secondary_text"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/loginPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="3.5dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="9dp"
                    android:background="@drawable/bg_section_bar" />

                <TextView
                    style="@style/SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wechat_connect" />
            </LinearLayout>

            <TextView
                android:id="@+id/loginStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="@string/not_logged_in"
                android:textColor="@color/danger"
                android:textSize="14sp" />

            <Button
                android:id="@+id/reloginButton"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="11dp"
                android:text="@string/relogin_action"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/loginGuts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/wechat_login_help"
                android:textColor="@color/secondary_text"
                android:textSize="12.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/copyLoginLinkButton"
                    style="@style/SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/copy_login_link" />

                <Button
                    android:id="@+id/clearLoginButton"
                    style="@style/SecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="9dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/clear_login" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="@string/callback_link"
                android:textColor="@color/secondary_text"
                android:textSize="12.5sp" />

            <EditText
                android:id="@+id/authUrlInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_field"
                android:hint="@string/callback_link_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="#7FB0A29A"
                android:textSize="13.5sp" />

            <Button
                android:id="@+id/parseLoginButton"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="@string/parse_login" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/configPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="3.5dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="9dp"
                    android:background="@drawable/bg_section_bar" />

                <TextView
                    style="@style/SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/seat_config" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/roomSpinner"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field"
                    android:contentDescription="@string/room" />

                <Button
                    android:id="@+id/refreshRoomsButton"
                    style="@style/SecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="9dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/refresh" />
            </LinearLayout>

            <Button
                android:id="@+id/selectSeatsButton"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="@string/select_seats" />

            <TextView
                android:id="@+id/seatSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/any_seat"
                android:textColor="@color/secondary_text"
                android:textSize="12.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/modePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="3.5dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="9dp"
                    android:background="@drawable/bg_section_bar" />

                <TextView
                    style="@style/SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_mode" />
            </LinearLayout>

            <RadioGroup
                android:id="@+id/modeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/realtimeMode"
                    style="@style/SegmentOption"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/realtime_mode" />

                <RadioButton
                    android:id="@+id/tomorrowMode"
                    style="@style/SegmentOption"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="@string/tomorrow_mode" />
            </RadioGroup>

            <TextView
                android:id="@+id/tomorrowHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/tomorrow_hint"
                android:textColor="@color/secondary_text"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/tomorrowTimeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@id/tomorrowTime"
                    android:text="@string/start_time"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/tomorrowTime"
                    android:layout_width="112dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_field"
                    android:gravity="center"
                    android:inputType="time"
                    android:importantForAutofill="no"
                    android:maxLength="8"
                    android:singleLine="true"
                    android:text="@string/default_start_time"
                    android:textColor="@color/ink" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/startButton"
                    style="@style/PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="@string/start_task" />

                <Button
                    android:id="@+id/stopButton"
                    style="@style/SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/stop_task" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/logsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="3.5dp"
                        android:layout_height="15dp"
                        android:layout_marginEnd="9dp"
                        android:background="@drawable/bg_section_bar" />

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/run_logs" />
                </LinearLayout>

                <Button
                    android:id="@+id/copyLogsButton"
                    style="@style/HeaderButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/copy_logs"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:fontFamily="monospace"
                android:minHeight="108dp"
                android:text="@string/no_logs"
                android:textColor="@color/secondary_text"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
